      "task": "task2",
      "input": {
        "array": [
          7
        ],
        "result": [
          0,
          1
        ]
      },
      "condition": "post",
      "spec": "cutpoints are non-empty, start at 0, end at n, and every cutpoint is within 0..n",
      "expected": true
    },
    {

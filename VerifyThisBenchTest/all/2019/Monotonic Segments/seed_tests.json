          7
        ]
      },
      "condition": "post",
      "spec": "each segment between consecutive cutpoints is monotonic",
      "expected": true
    },
    {
      "id": "T014",
      "task": "task3",
      "input": {
        "array": [
          6,
          3,
          4,
          2,

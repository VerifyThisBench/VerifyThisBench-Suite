{
  "challenge": "Monotonic Segments",
  "description": "Compute cutpoints that partition an integer sequence into monotonic segments, with separate verification of basic cutpoint properties, monotonicity, and maximality.",
  "function_signature": "monotonic_cutpoints(array) -> cutpoints",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "array": [
          1,
          4,
          7,
          3,
          3,
          5,
          9
        ]
      },
      "condition": "pre",
      "spec": "input array is not null",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "array": []
      },
      "condition": "pre",
      "spec": "empty array is allowed because sequence length may be 0",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "array": [
          5
        ]
      },
      "condition": "pre",
      "spec": "single-element array is allowed",
      "expected": true
    },
    {

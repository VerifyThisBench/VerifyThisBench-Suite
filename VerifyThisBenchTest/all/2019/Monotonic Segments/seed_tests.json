          7
        ],
        "result": [
          0,
          2,
          4,
          6,
          7
        ]
      },
      "condition": "post",
      "spec": "each segment between consecutive cutpoints is monotonic",
      "expected": true
    },
    {
      "id": "T015",
      "task": "task3",
      "input": {
        "array": [
          2,
          2,
          2
        ],
        "result": [
          0,
          3
        ]
      },
      "condition": "post",
      "spec": "a segment of equal values is monotonic because it is non-increasing",
      "expected": true
    },
    {
      "id": "T016",
      "task": "task3",
      "input": {
        "array": [
          -3,

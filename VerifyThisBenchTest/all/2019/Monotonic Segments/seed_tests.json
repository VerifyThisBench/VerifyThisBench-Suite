          0,
          -2
        ],
        "result": [
          0,
          3,
          4
        ]
      },
      "condition": "post",
      "spec": "monotonicity must hold for arrays containing negative numbers",
      "expected": true
    },
    {
      "id": "T017",
      "task": "task3",
      "input": {
        "array": [
          1,
          4,
          7,
          3,
          3,
          5,
          9
        ],
        "result": [
          0,
          4,
          7
        ]
      },
      "condition": "post",
      "spec": "segment [1,4,7,3] is not monotonic, so every segment between cutpoints must be monotonic",
      "expected": false
    },
    {
      "id": "T018",
      "task": "task3",
      "input": {
        "array": [
          6,
          3,
          4,
          2,

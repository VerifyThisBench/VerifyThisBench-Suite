    },
    {
      "id": "T019",
      "task": "task3",
      "input": {
        "array": [
          1,
          3,
          2
        ],
        "result": [
          0,
          3
        ]
      },
      "condition": "post",
      "spec": "entire segment [1,3,2] is not monotonic",
      "expected": false
    },
    {
      "id": "T020",
      "task": "task4",
      "input": {
        "array": [
          1,
          4,
          7,
          3,
          3,
          5,
          9
        ],
        "result": [
          0,
          3,
          5,
          7
        ]
      },
      "condition": "post",
      "spec": "cutpoints are maximal: extending any segment by one element would break monotonicity",
      "expected": true
    },
    {
      "id": "T021",
      "task": "task4",
      "input": {
        "array": [
          6,
          3,
          4,
          2,
          5,
          3,
          7
        ],
        "result": [
          0,
          2,
          4,
          6,
          7
        ]
      },
      "condition": "post",
      "spec": "cutpoints are maximal: each segment is as long as possible while remaining monotonic",
      "expected": true
    },
    {
      "id": "T022",
      "task": "task4",
      "input": {
        "array": [
          1,
          2,
          3,
          4
        ],
        "result": [
          0,
          4
        ]
      },
      "condition": "post",
      "spec": "a single increasing segment over the whole array is maximal",
      "expected": true
    },
    {
      "id": "T023",
      "task": "task4",
      "input": {
        "array": [
          1,
          4,
          7,
          3,
          3,
          5,
          9
        ],
        "result": [
          0,
          2,
          3,
          5,
          7
        ]
      },
      "condition": "post",
      "spec": "cutpoints are not maximal if a segment is split even though it can be extended and remain monotonic",
      "expected": false
    },
    {
      "id": "T024",
      "task": "task4",
      "input": {
        "array": [
          2,
          2,
          2
        ],
        "result": [
          0,
          1,
          3
        ]
      },
      "condition": "post",
      "spec": "for equal values, splitting into shorter non-increasing segments is not maximal because the first segment can be extended",
      "expected": false
    },
    {
      "id": "T025",
      "task": "task3",
      "input": {
        "array": [
          1,
          4,
          7,
          3,
          3,
          5,
          9
        ],
        "result": [
          0,
          5,
          7
        ]
      },
      "condition": "post",
      "spec": "segment [1,4,7,3,3] mixes an increase then a decrease, so it is not monotonic",
      "expected": false
    },
    {
      "id": "T026",
      "task": "task3",
      "input": {
        "array": [
          5,
          1,
          2,
          3
        ],
        "result": [
          0,
          4
        ]
      },
      "condition": "post",
      "spec": "[5,1,2,3] is neither all increasing nor non-increasing across the whole range, so a single segment is not monotonic",
      "expected": false
    },
    {
      "id": "T027",
      "task": "task4",
      "input": {
        "array": [
          1,
          2,
          3,
          4
        ],
        "result": [
          0,
          2,
          4
        ]
      },
      "condition": "post",
      "spec": "splitting an already-monotonic [1,2,3,4] into two parts is not maximal because the first segment can be extended",

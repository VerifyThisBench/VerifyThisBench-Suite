{
  "challenge": "Sparse Matrix Multiplication",
  "description": "Multiply an input vector by a sparse matrix in COO format to produce an output vector.",
  "function_signature": "sparse_vec_mat_mul(x, m, rows, cols) -> y",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "x": [
          2,
          3,
          4,
          5
        ],
        "m": [
          {
            "row": 1,
            "col": 1,
            "value": 7
          },
          {
            "row": 2,
            "col": 3,
            "value": -1
          },
          {
            "row": 4,
            "col": 2,
            "value": 6
          }
        ],
        "rows": 4,
        "cols": 3
      },
      "condition": "pre",
      "spec": "input vector length equals number of matrix rows and all triplet indices are within 1..rows and 1..cols",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "x": [],
        "m": [],
        "rows": 0,
        "cols": 0
      },
      "condition": "pre",
      "spec": "empty vector and empty sparse matrix are valid when dimensions are zero",
      "expected": true

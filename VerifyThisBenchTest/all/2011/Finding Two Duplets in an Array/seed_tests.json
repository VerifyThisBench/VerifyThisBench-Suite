{
  "challenge": "Finding Two Duplets in an Array",
  "description": "Find two values in an integer array of length n+2 such that both values occur at least twice, assuming values are in the range 0 to n-1.",
  "function_signature": "find_two_duplets(array) -> [value1, value2]",
  "seed_tests": [

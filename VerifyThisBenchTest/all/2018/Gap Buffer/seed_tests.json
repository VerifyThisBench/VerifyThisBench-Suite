            "_",
            "a"
          ],
          "l": 0,
          "r": 2
        }
      },
      "condition": "post",
      "spec": "left leaves the buffer unchanged when l == 0",
      "expected": true
    },
    {
      "id": "T016",
      "task": "task2",
      "input": {
        "buffer": {
          "buffer": [
            "h",

            "c"
          ],
          "l": 1,
          "r": 3
        },
        "op": "right",
        "result": {
          "buffer": [
            "a",
            "c",
            "_",
            "_",
            "c"
          ],
          "l": 2,
          "r": 4
        }
      },
      "condition": "post",
      "spec": "right copies the character at the right side of the gap into the old left gap boundary",
      "expected": false
    },
    {
      "id": "T011",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b"
          ],
          "l": 1,
          "r": 3
        },
        "op": "insert",
        "x": "x",
        "result": {
          "buffer": [
            "a",
            "x",
            "_",
            "b"
          ],
          "l": 2,
          "r": 3
        }
      },
      "condition": "post",
      "spec": "insert writes x at a[l] and increments l when the gap is nonempty",
      "expected": true
    },
    {
      "id": "T012",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b"
          ],
          "l": 1,
          "r": 3
        },
        "op": "insert",
        "x": "x",
        "result": {
          "buffer": [
            "a",
            "_",
            "x",
            "b"
          ],
          "l": 2,
          "r": 3
        }
      },
      "condition": "post",
      "spec": "insert places the new character at the beginning of the gap, not elsewhere",
      "expected": false
    },
    {

            "_",
            "c"
          ],
          "l": 2,
          "r": 4
        }
      },
      "condition": "post",
      "spec": "delete changes l when there is a character before the cursor",
      "expected": false
    },
    {
      "id": "T015",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "_",
            "_",
            "a"
          ],
          "l": 0,
          "r": 2
        },
        "op": "left",
        "result": {
          "buffer": [

{
  "challenge": "Gap Buffer",
  "description": "Verify gap buffer operations and abstraction to contiguous editor content, including growth when the gap is empty.",
  "function_signature": "operation(buffer: {buffer: [char], l: int, r: int}, op: string, x?: char) -> {buffer: [char], l: int, r: int}",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b",
            "c"
          ],
          "l": 1,
          "r": 3
        },
        "op": "left"
      },
      "condition": "pre",
      "spec": "buffer is not null and indices satisfy 0 <= l <= r <= length(buffer)",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "b",
            "_"
          ],
          "l": 0,
          "r": 2
        },
        "op": "right"
      },
      "condition": "pre",
      "spec": "buffer is not null and indices satisfy 0 <= l <= r <= length(buffer)",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "buffer": null,
        "op": "left"
      },
      "condition": "pre",
      "spec": "buffer structure is not null",
      "expected": false
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "b",
            "c"
          ],
          "l": -1,
          "r": 1
        },
        "op": "delete"
      },
      "condition": "pre",
      "spec": "left gap index l is nonnegative",
      "expected": false
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "b",
            "c"
          ],
          "l": 2,
          "r": 1
        },
        "op": "insert",
        "x": "z"
      },
      "condition": "pre",
      "spec": "indices satisfy l <= r",
      "expected": false
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_"
          ],
          "l": 1,
          "r": 4
        },
        "op": "right"
      },
      "condition": "pre",
      "spec": "right gap index r does not exceed buffer length",
      "expected": false
    },
    {
      "id": "T007",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b"
          ],
          "l": 1,
          "r": 3
        },
        "op": "left",
        "result": {
          "buffer": [
            "a",
            "_",
            "a",
            "b"
          ],
          "l": 0,
          "r": 2
        }
      },
      "condition": "post",
      "spec": "left moves cursor one position left when l != 0 and preserves represented text",
      "expected": true
    },
    {
      "id": "T008",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b"
          ],
          "l": 1,
          "r": 3
        },
        "op": "left",
        "result": {
          "buffer": [
            "a",
            "_",
            "_",
            "b"
          ],
          "l": 0,
          "r": 2
        }
      },
      "condition": "post",
      "spec": "left copies the character before the cursor into the cell just before the new right gap boundary",
      "expected": false
    },
    {
      "id": "T009",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",
            "_",
            "b",
            "c"
          ],
          "l": 1,
          "r": 3
        },
        "op": "right",
        "result": {
          "buffer": [
            "a",
            "b",
            "_",
            "_",
            "c"
          ],
          "l": 2,
          "r": 4
        }
      },
      "condition": "post",
      "spec": "right moves cursor one position right when r < length and preserves represented text",
      "expected": true
    },
    {
      "id": "T010",
      "task": "task1",
      "input": {
        "buffer": {
          "buffer": [
            "a",
            "_",

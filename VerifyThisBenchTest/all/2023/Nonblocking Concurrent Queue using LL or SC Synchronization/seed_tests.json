{
  "challenge": "Nonblocking Concurrent Queue using LL or SC Synchronization",
  "description": "Validate termination, index safety, and final-state properties of concurrent enqueue/dequeue executions over a bounded cyclic queue.",
  "function_signature": "run_execution(LEN, NT, initial_queue, threads) -> final_state",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "LEN": 3,
        "NT": 1,
        "initial_queue": {
          "Q": [
            -1,
            -1,
            -1
          ],
          "Head": 0,
          "Tail": 0
        },
        "threads": [
          0
        ]
      },
      "condition": "pre",
      "spec": "initial queue is empty: Head = Tail = 0 and all array entries are null (-1)",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "LEN": 4,
        "NT": 3,
        "initial_queue": {
          "Q": [
            -1,
            -1,
            -1,
            -1
          ],
          "Head": 0,
          "Tail": 0
        },
        "threads": [
          0,
          1,
          2
        ]
      },
      "condition": "pre",
      "spec": "thread IDs are exactly 0..NT-1 and initial queue is empty",
      "expected": true
    },
    {

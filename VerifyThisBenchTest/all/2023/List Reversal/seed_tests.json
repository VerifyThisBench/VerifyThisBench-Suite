{
  "challenge": "List Reversal",
  "description": "Reverse a singly linked list in place, handling both null-terminated and lasso-shaped well-formed lists.",
  "function_signature": "list_reversal(list) -> result",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "list": null
      },
      "condition": "pre",
      "spec": "null is a well-formed empty list",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "list": {
          "value": 1,
          "next": {
            "value": 2,
            "next": {
              "value": 3,
              "next": null
            }
          }
        }
      },
      "condition": "pre",
      "spec": "a finite null-terminated acyclic list is well-formed",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "list": {
          "entry": 0,
          "nodes": [
            {
              "value": 1,
              "next": 1
            },
            {
              "value": 2,
              "next": 2
            },
            {
              "value": 3,
              "next": 1
            }
          ]
        }
      },
      "condition": "pre",
      "spec": "a lasso-shaped list with a finite prefix and a cycle is well-formed",
      "expected": true
    },
    {

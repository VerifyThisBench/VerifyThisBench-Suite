{
  "challenge": "Prefix-Sum",
  "description": "Computes exclusive prefix sums of an integer array using upsweep and downsweep, assuming array length is a power of two.",
  "function_signature": "prefix_sum(array) -> array",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "array": [
          3,
          1,
          7,
          0,
          4,
          1,
          6,
          3
        ]
      },
      "condition": "pre",
      "spec": "array is not null and length is a positive power of two",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "array": [
          5
        ]
      },
      "condition": "pre",
      "spec": "single-element array is allowed because length 1 is a power of two",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "array": [
          2,
          -1,
          4,
          0
        ]
      },
      "condition": "pre",
      "spec": "array with negative numbers is allowed if length is a power of two",
      "expected": true
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "array": null
      },
      "condition": "pre",
      "spec": "array is not null",
      "expected": false
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "array": []
      },
      "condition": "pre",
      "spec": "array length must be positive",
      "expected": false
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "array": [
          1,
          2,
          3
        ]
      },
      "condition": "pre",
      "spec": "array length must be a power of two",
      "expected": false
    },
    {
      "id": "T007",
      "task": "task1",
      "input": {
        "array": [
          1,
          2,
          3,

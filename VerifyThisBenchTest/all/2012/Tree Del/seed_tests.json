              "left": null,
              "right": null
            },
            "right": {
              "value": 4,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 8,
            "left": {
              "value": 6,
              "left": null,
              "right": null
            },
            "right": {
              "value": 9,
              "left": null,
              "right": null
            }
          }
        },
        "result": [
          {
            "value": 5,
            "left": {
              "value": 3,
              "left": null,
              "right": {
                "value": 4,
                "left": null,
                "right": null
              }
            },
            "right": {
              "value": 8,
              "left": {
                "value": 6,
                "left": null,
                "right": null
              },
              "right": {
                "value": 9,
                "left": null,
                "right": null
              }
            }
          },
          1
        ]
      },
      "condition": "post",
      "spec": "delete the leftmost node, return its key, and preserve BST structure when the minimum is a leaf",
      "expected": true
    },
    {
      "id": "T011",
      "task": "task1",
      "input": {
        "tree": {
          "value": 10,
          "left": {
            "value": 5,
            "left": {
              "value": 2,
              "left": null,
              "right": {
                "value": 3,
                "left": null,
                "right": null
              }
            },
            "right": {
              "value": 7,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 12,
            "left": null,
            "right": null
          }
        },
        "result": [
          {
            "value": 10,
            "left": {
              "value": 5,
              "left": {
                "value": 3,
                "left": null,
                "right": null
              },
              "right": {
                "value": 7,
                "left": null,
                "right": null
              }
            },
            "right": {
              "value": 12,
              "left": null,
              "right": null
            }
          },
          2
        ]
      },
      "condition": "post",
      "spec": "when the minimum node has a right subtree, that right subtree is reattached as the left child of the minimum node's parent",
      "expected": true
    },
    {
      "id": "T012",
      "task": "task1",
      "input": {
        "tree": {
          "value": 0,
          "left": {
            "value": -3,
            "left": {
              "value": -5,
              "left": null,
              "right": null
            },
            "right": {
              "value": -1,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 4,
            "left": null,
            "right": null
          }
        },
        "result": [
          {
            "value": 0,
            "left": {
              "value": -3,
              "left": null,
              "right": {
                "value": -1,
                "left": null,
                "right": null
              }
            },
            "right": {
              "value": 4,
              "left": null,
              "right": null
            }
          },
          -5
        ]
      },
      "condition": "post",
      "spec": "the returned minimum is the smallest key even when keys are negative, and the resulting tree remains a BST",
      "expected": true
    },
    {
      "id": "T013",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": null,
          "right": null
        },
        "result": [
          null,

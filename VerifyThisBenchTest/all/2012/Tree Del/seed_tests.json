{
  "challenge": "Tree Del",
  "description": "Delete the node with the minimal key from a non-empty binary search tree and return the updated tree and removed minimum value",
  "function_signature": "search_tree_delete_min(tree) -> [result_tree, result_min]",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": {
            "value": 3,
            "left": {
              "value": 1,
              "left": null,
              "right": null
            },
            "right": {
              "value": 4,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 8,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "tree is not null and satisfies the binary search tree ordering property",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "tree": {
          "value": 7,
          "left": null,
          "right": {
            "value": 9,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "tree is non-empty; a single-root BST with no left child is valid input",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "tree": {
          "value": 0,
          "left": {
            "value": -3,
            "left": {
              "value": -5,
              "left": null,
              "right": null
            },
            "right": {
              "value": -1,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 4,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "BST input may contain negative keys as long as ordering holds",
      "expected": true
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "tree": null
      },
      "condition": "pre",
      "spec": "tree must be non-empty and not null",
      "expected": false
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": {
            "value": 6,
            "left": null,
            "right": null
          },
          "right": {
            "value": 8,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "all keys in the left subtree must be strictly smaller than the root key",
      "expected": false
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": {
            "value": 3,
            "left": null,
            "right": {
              "value": 6,
              "left": null,
              "right": null
            }
          },
          "right": {
            "value": 8,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "every node in a left subtree must be less than the ancestor root key",
      "expected": false
    },
    {
      "id": "T007",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": null,
          "right": {
            "value": 4,
            "left": null,
            "right": null
          }
        }
      },
      "condition": "pre",
      "spec": "all keys in the right subtree must be strictly greater than the root key",
      "expected": false
    },
    {
      "id": "T008",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": null,
          "right": null
        },
        "result": [
          null,
          5
        ]
      },
      "condition": "post",
      "spec": "for a single-node BST, the minimum is the root key and the resulting tree is empty",
      "expected": true
    },
    {
      "id": "T009",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": null,
          "right": {
            "value": 7,
            "left": {
              "value": 6,
              "left": null,
              "right": null
            },
            "right": {
              "value": 9,
              "left": null,
              "right": null
            }
          }
        },
        "result": [
          {
            "value": 7,
            "left": {
              "value": 6,
              "left": null,
              "right": null
            },
            "right": {
              "value": 9,
              "left": null,
              "right": null
            }
          },
          5
        ]
      },
      "condition": "post",
      "spec": "if the root has no left child, delete the root, return its key as minimum, and promote the right subtree",
      "expected": true
    },
    {
      "id": "T010",
      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": {
            "value": 3,

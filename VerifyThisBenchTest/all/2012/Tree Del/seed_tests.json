      "task": "task1",
      "input": {
        "tree": {
          "value": 5,
          "left": null,
          "right": {
            "value": 7,
            "left": null,
            "right": null
          }
        },
        "result": [
          {
            "value": 5,
            "left": null,
            "right": {
              "value": 7,
              "left": null,
              "right": null
            }
          },
          5
        ]

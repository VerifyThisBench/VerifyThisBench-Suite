{
  "challenge": "Dancing Links",
  "description": "Remove a node from a doubly linked list and reinsert it so predecessor and successor links are updated exactly as described.",
  "function_signature": "operate(prev, next, n, x, op) -> {prev, next}",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "prev and next arrays are not null and have length n",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "prev": [
          3,
          0,
          1,
          2
        ],
        "next": [
          1,
          2,
          3,
          0
        ],
        "n": 4,
        "x": 2,
        "op": "restore"
      },
      "condition": "pre",
      "spec": "x is a valid node index with 0 <= x < n",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "prev": null,
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "prev array is not null",
      "expected": false
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": null,
        "n": 3,
        "x": 1,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "next array is not null",
      "expected": false
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "prev and next arrays have length exactly n",
      "expected": false
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": -1,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "x is a valid node index with 0 <= x < n",
      "expected": false
    },
    {
      "id": "T007",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 3,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "x is a valid node index with 0 <= x < n",
      "expected": false
    },
    {
      "id": "T008",
      "task": "task1",
      "input": {
        "prev": [],
        "next": [],
        "n": 0,
        "x": 0,
        "op": "remove"
      },
      "condition": "pre",
      "spec": "cannot operate on an empty structure because x must be a valid index",
      "expected": false
    },
    {
      "id": "T009",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "remove",
        "result": {
          "prev": [
            2,
            0,
            1
          ],
          "next": [
            2,
            2,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "remove updates successor of predecessor and predecessor of successor: next[prev[x]] = next[x] and prev[next[x]] = prev[x]",
      "expected": true
    },
    {
      "id": "T010",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          1,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "remove",
        "result": {
          "prev": [
            2,
            0,
            0
          ],
          "next": [
            2,
            2,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "remove leaves prev[x] and next[x] themselves unchanged while reconnecting neighbors only",
      "expected": false
    },
    {
      "id": "T011",
      "task": "task1",
      "input": {
        "prev": [
          3,
          0,
          1,
          2
        ],
        "next": [
          1,
          2,
          3,
          0
        ],
        "n": 4,
        "x": 2,
        "op": "remove",
        "result": {
          "prev": [
            3,
            0,
            1,
            1
          ],
          "next": [
            1,
            3,
            3,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "remove correctly bypasses x in a larger circular list",
      "expected": true
    },
    {
      "id": "T012",
      "task": "task1",
      "input": {
        "prev": [
          3,
          0,
          1,
          2
        ],
        "next": [
          1,
          2,
          3,
          0
        ],
        "n": 4,
        "x": 2,
        "op": "remove",
        "result": {
          "prev": [
            3,
            0,
            1,
            2
          ],
          "next": [
            1,
            3,
            3,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "remove must update both affected links, including prev[next[x]]",
      "expected": false
    },
    {
      "id": "T013",
      "task": "task1",
      "input": {
        "prev": [
          0
        ],
        "next": [
          0
        ],
        "n": 1,
        "x": 0,
        "op": "remove",
        "result": {
          "prev": [
            0
          ],
          "next": [
            0
          ]
        }
      },
      "condition": "post",
      "spec": "removing the only node in a one-element circular list leaves the self-links unchanged",
      "expected": true
    },
    {
      "id": "T014",
      "task": "task1",
      "input": {
        "prev": [
          0
        ],
        "next": [
          0
        ],
        "n": 1,
        "x": 0,
        "op": "remove",
        "result": {
          "prev": [
            0
          ],
          "next": [
            1
          ]
        }
      },
      "condition": "post",
      "spec": "resulting arrays after remove must still reflect the prescribed assignments even for a single node",
      "expected": false
    },
    {
      "id": "T015",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          2,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "restore",
        "result": {
          "prev": [
            2,
            0,
            1
          ],
          "next": [
            1,
            2,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restore reinserts x by setting next[prev[x]] = x and prev[next[x]] = x",
      "expected": true
    },
    {
      "id": "T016",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          2,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "restore",
        "result": {
          "prev": [
            2,
            0,
            2
          ],
          "next": [
            1,
            2,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restore must reconnect neighbors using x without altering prev[x] or next[x] themselves",
      "expected": false
    },
    {
      "id": "T017",
      "task": "task1",
      "input": {
        "prev": [
          3,
          0,
          1,
          1
        ],
        "next": [
          1,
          3,
          3,
          0
        ],
        "n": 4,
        "x": 2,
        "op": "restore",
        "result": {
          "prev": [
            3,
            0,
            1,
            2
          ],
          "next": [
            1,
            2,
            3,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restore reconstructs the original circular list when x retains its old prev and next links",
      "expected": true
    },
    {
      "id": "T018",
      "task": "task1",
      "input": {
        "prev": [
          3,
          0,
          1,
          1
        ],
        "next": [
          1,
          3,
          3,
          0
        ],
        "n": 4,
        "x": 2,
        "op": "restore",
        "result": {
          "prev": [
            3,
            0,
            1,
            2
          ],
          "next": [
            1,
            3,
            3,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restore must update next[prev[x]] to x; leaving predecessor linked past x is incorrect",
      "expected": false
    },
    {
      "id": "T019",
      "task": "task1",
      "input": {
        "prev": [
          0
        ],
        "next": [
          0
        ],
        "n": 1,
        "x": 0,
        "op": "restore",
        "result": {
          "prev": [
            0
          ],
          "next": [
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restoring the only node in a one-element circular list leaves self-links unchanged",
      "expected": true
    },
    {
      "id": "T020",
      "task": "task1",
      "input": {
        "prev": [
          4,
          0,
          1,
          2,
          3
        ],
        "next": [
          1,
          2,
          3,
          4,
          0
        ],
        "n": 5,
        "x": 0,
        "op": "remove",
        "result": {
          "prev": [
            4,
            4,
            1,
            2,
            3
          ],
          "next": [
            1,
            2,
            3,
            4,
            1
          ]
        }
      },
      "condition": "post",
      "spec": "remove works when x is the distinguished index 0 in a larger circular list",
      "expected": true
    },
    {
      "id": "T021",
      "task": "task1",
      "input": {
        "prev": [
          4,
          0,
          1,
          2,
          3
        ],
        "next": [
          1,
          2,
          3,
          4,
          0
        ],
        "n": 5,
        "x": 0,
        "op": "remove",
        "result": {
          "prev": [
            4,
            0,
            1,
            2,
            3
          ],
          "next": [
            1,
            2,
            3,
            4,
            1
          ]
        }
      },
      "condition": "post",
      "spec": "remove must update prev[next[x]] as well as next[prev[x]] when removing index 0",
      "expected": false
    },
    {
      "id": "T022",
      "task": "task1",
      "input": {
        "prev": [
          2,
          0,
          1
        ],
        "next": [
          2,
          2,
          0
        ],
        "n": 3,
        "x": 1,
        "op": "restore",
        "result": {
          "prev": [
            2,
            0,
            1
          ],
          "next": [
            2,
            2,
            0
          ]
        }
      },
      "condition": "post",
      "spec": "restore must change next[prev[x]] and prev[next[x]] to x; returning the input arrays unchanged is wrong",
      "expected": false
    }
  ]
}

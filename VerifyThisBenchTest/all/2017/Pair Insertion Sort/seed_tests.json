{
  "challenge": "Pair Insertion Sort",
  "description": "Sort an integer array using pair insertion sort so that the result is sorted and is a permutation of the input.",
  "function_signature": "pair_insertion_sort(array) -> array",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "array": [
          3,
          1,
          2
        ]
      },
      "condition": "pre",
      "spec": "array is not null",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "array": []
      },
      "condition": "pre",
      "spec": "empty array is allowed as valid input",
      "expected": true
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "array": [
          5
        ]
      },
      "condition": "pre",
      "spec": "single-element array is allowed as valid input",
      "expected": true
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "array": null
      },
      "condition": "pre",
      "spec": "array is not null",
      "expected": false
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "array": [
          4,
          1,
          3,
          2
        ],
        "result": [
          1,
          2,
          3,
          4
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order",
      "expected": true
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "array": [
          4,
          1,
          3,
          2
        ],
        "result": [
          1,
          3,
          2,
          4
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order",
      "expected": false
    },
    {
      "id": "T007",
      "task": "task1",
      "input": {
        "array": [
          3,
          1,
          2
        ],
        "result": [
          1,
          2,
          3
        ]
      },
      "condition": "post",
      "spec": "result is a permutation of the input array",
      "expected": true
    },
    {
      "id": "T008",
      "task": "task1",
      "input": {
        "array": [
          3,
          1,
          2
        ],
        "result": [
          1,
          2,
          4
        ]
      },
      "condition": "post",
      "spec": "result is a permutation of the input array",
      "expected": false
    },
    {
      "id": "T009",
      "task": "task1",
      "input": {
        "array": [
          5,
          5,
          5,
          5
        ],
        "result": [
          5,
          5,
          5,
          5
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order and preserves duplicate multiplicities",
      "expected": true
    },
    {
      "id": "T010",
      "task": "task1",
      "input": {
        "array": [
          2,
          2,
          1
        ],
        "result": [
          1,
          2,
          2
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order and is a permutation when duplicates occur",
      "expected": true
    },
    {
      "id": "T011",
      "task": "task1",
      "input": {
        "array": [
          2,
          2,
          1
        ],
        "result": [
          1,
          1,
          2
        ]
      },
      "condition": "post",
      "spec": "result is a permutation of the input array when duplicates occur",
      "expected": false
    },
    {
      "id": "T012",
      "task": "task1",
      "input": {
        "array": [
          -1,
          3,
          0,
          -2
        ],
        "result": [
          -2,
          -1,
          0,
          3
        ]
      },
      "condition": "post",
      "spec": "result correctly sorts arrays containing negative numbers",
      "expected": true
    },
    {
      "id": "T013",
      "task": "task1",
      "input": {
        "array": [
          -1,
          3,
          0,
          -2
        ],
        "result": [
          -2,
          0,
          -1,
          3
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order for arrays containing negative numbers",
      "expected": false
    },
    {
      "id": "T014",
      "task": "task1",
      "input": {
        "array": [
          42
        ],
        "result": [
          42
        ]
      },
      "condition": "post",
      "spec": "single-element result is sorted and is a permutation of the input",
      "expected": true
    },
    {
      "id": "T015",
      "task": "task1",
      "input": {
        "array": [],
        "result": []
      },
      "condition": "post",
      "spec": "empty result is sorted and is a permutation of the empty input",
      "expected": true
    },
    {
      "id": "T016",
      "task": "task1",
      "input": {
        "array": [
          7,
          6,
          5,
          4,
          3
        ],
        "result": [
          3,
          4,
          5,
          6,
          7
        ]
      },
      "condition": "post",
      "spec": "result correctly sorts an odd-length array requiring a final single insertion step",
      "expected": true
    },
    {
      "id": "T017",
      "task": "task1",
      "input": {
        "array": [
          7,
          6,
          5,
          4,
          3
        ],
        "result": [
          3,
          4,
          5,
          7,
          6
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nondecreasing order for an odd-length array",
      "expected": false
    },
    {
      "id": "T018",
      "task": "task1",
      "input": {
        "array": [
          1,
          2,
          3,
          4
        ],
        "result": [
          1,
          2,
          3,
          4
        ]
      },
      "condition": "post",
      "spec": "already sorted input remains sorted and is a permutation of the input",
      "expected": true
    },
    {
      "id": "T019",
      "task": "task1",
      "input": {
        "array": [
          0,
          -1,
          0,
          2
        ],
        "result": [
          -1,
          0,
          0,
          2
        ]
      },
      "condition": "post",
      "spec": "result is sorted and preserves repeated zero values",
      "expected": true
    },
    {
      "id": "T020",
      "task": "task1",
      "input": {
        "array": [
          0,
          -1,
          0,
          2
        ],
        "result": [
          -1,
          0,
          2,
          2
        ]
      },
      "condition": "post",
      "spec": "result is a permutation of the input array with repeated values",
      "expected": false
    },
    {
      "id": "T021",
      "task": "task1",
      "input": {
        "array": [
          4,
          1,
          3,
          2
        ],
        "result": [
          4,
          3,
          2,
          1
        ]
      },
      "condition": "post",
      "spec": "result is sorted in nonincreasing rather than nondecreasing order, violating the sortedness postcondition",
      "expected": false
    },
    {
      "id": "T022",
      "task": "task1",
      "input": {
        "array": [
          3,
          1,
          2
        ],
        "result": [
          1,
          2,
          3,
          3
        ]
      },
      "condition": "post",
      "spec": "result has an extra duplicated element, so it is not a permutation of the input",
      "expected": false
    },
    {
      "id": "T023",
      "task": "task1",
      "input": {
        "array": [
          7,
          6,
          5,
          4,
          3
        ],
        "result": [
          3,
          4,
          5,
          6
        ]
      },
      "condition": "post",
      "spec": "result drops the last element, violating the permutation requirement (length mismatch)",
      "expected": false
    },
    {
      "id": "T024",
      "task": "task1",
      "input": {
        "array": [
          2,
          2,
          1
        ],
        "result": [
          2,
          2,
          1
        ]
      },
      "condition": "post",
      "spec": "result is the input returned unchanged, which is not in nondecreasing order",
      "expected": false
    }
  ]
}

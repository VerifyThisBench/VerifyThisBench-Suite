          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 1,
            "y": 1,
            "z": 1
          }
        ],
        "voxel_size": 2,
        "result": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          }
        ]
      },
      "condition": "post",
      "spec": "all points in one voxel are replaced by their average point using integer coordinates",
      "expected": true
    },

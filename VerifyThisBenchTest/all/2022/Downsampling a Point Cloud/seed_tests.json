{
  "challenge": "Downsampling a Point Cloud",
  "description": "Downsample a point cloud by grouping points into voxels and replacing each non-empty voxel with the average point in that voxel.",
  "function_signature": "downSample(p, voxel_size) -> pd",
  "seed_tests": [
    {
      "id": "T001",
      "task": "task1",
      "input": {
        "p": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 1,
            "y": 1,
            "z": 1
          },
          {
            "x": 2,
            "y": 2,
            "z": 2
          }
        ],
        "voxel_size": 1
      },
      "condition": "pre",
      "spec": "input point cloud is not null",
      "expected": true
    },
    {
      "id": "T002",
      "task": "task1",
      "input": {
        "p": null,
        "voxel_size": 1
      },
      "condition": "pre",
      "spec": "input point cloud is not null",
      "expected": false
    },
    {
      "id": "T003",
      "task": "task1",
      "input": {
        "p": [],
        "voxel_size": 1
      },
      "condition": "pre",
      "spec": "input point cloud is non-empty so min and max are defined",
      "expected": false
    },
    {
      "id": "T004",
      "task": "task1",
      "input": {
        "p": [
          {
            "x": 5,
            "y": 5,
            "z": 5
          }
        ],
        "voxel_size": 1
      },
      "condition": "pre",
      "spec": "single-point cloud is allowed",
      "expected": true
    },
    {
      "id": "T005",
      "task": "task1",
      "input": {
        "p": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 2,
            "y": 2,
            "z": 2
          }
        ],
        "voxel_size": 0
      },
      "condition": "pre",
      "spec": "voxel_size must be strictly positive",
      "expected": false
    },
    {
      "id": "T006",
      "task": "task1",
      "input": {
        "p": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 2,
            "y": 2,
            "z": 2
          }
        ],
        "voxel_size": -1
      },
      "condition": "pre",
      "spec": "voxel_size must be strictly positive",
      "expected": false
    },
